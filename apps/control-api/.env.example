CONTROL_LISTEN_ADDRESS=127.0.0.1:8080
CONTROL_ALLOW_VOLATILE_STORE=true
# For a durable single-instance trial, use PostgreSQL and set the above false.
# A database URL in a mode-0600 file avoids putting credentials in arguments.
# CONTROL_DATABASE_URL_FILE=/etc/nyvp/database-url
# CONTROL_DATABASE_URL=postgres://localhost/nyvp_trial?sslmode=disable
CONTROL_BOOTSTRAP_ADMIN_USERNAME=admin
# Generate this value with: go run ./apps/control-api hash-password
CONTROL_BOOTSTRAP_ADMIN_PASSWORD_HASH=
# Local evaluation only. Prefer the versioned hash above.
# CONTROL_BOOTSTRAP_ADMIN_PASSWORD=
# Independent HMAC key for customer password-change idempotency. Generate 32
# random bytes and Base64-encode them; never reuse the administrator password.
CONTROL_CUSTOMER_PASSWORD_FINGERPRINT_KEY_B64=
# Prefer a protected file in deployed environments; set exactly one source.
# CONTROL_CUSTOMER_PASSWORD_FINGERPRINT_KEY_FILE=/etc/nyvp/customer-password-fingerprint-key
# Direct TLS is optional on loopback and required for non-loopback production use.
# CONTROL_TLS_CERT_FILE=
# CONTROL_TLS_KEY_FILE=
