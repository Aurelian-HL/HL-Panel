# Insert only inside the existing HTTPS server block after reviewing its
# current location rules. The server must negotiate HTTP/2 on 443.
# Dashboard must listen on 127.0.0.1:8008; do not expose its Web/API routes.
location ^~ /proto.NezhaService/ {
    grpc_set_header Host $host;
    grpc_set_header nz-realip $remote_addr;
    grpc_read_timeout 600s;
    grpc_send_timeout 600s;
    grpc_socket_keepalive on;
    client_max_body_size 10m;
    grpc_buffer_size 4m;
    grpc_pass grpc://127.0.0.1:8008;
}
