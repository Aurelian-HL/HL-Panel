# Copy to /etc/hl-panel/control-api.env and set:
#   owner root:hlpanel
#   mode  0640
# Never commit the populated file.

# install.sh sets this loopback port from --api-port (default 8080).
# Manual configuration must use the same port in the HL-panel Nginx proxy.
CONTROL_LISTEN_ADDRESS=127.0.0.1:8080
CONTROL_ALLOW_INSECURE_HTTP=false

# Durable PostgreSQL transactional snapshots for a single-instance trial.
# The URL file must be root:hlpanel 0640 and contain only the connection URL.
# Do not set CONTROL_DATABASE_URL as well; the two sources are exclusive.
CONTROL_ALLOW_VOLATILE_STORE=false
CONTROL_DATABASE_URL_FILE=/etc/hl-panel/database-url

CONTROL_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
# Generate through `control-api hash-password` using standard input. Store only
# the resulting versioned hash here, enclosed in double quotes because it
# begins with `$`. Never place the plaintext password in this file.
# Bootstrap creates an administrator only for an empty database. Changing this
# value does not rotate credentials already persisted in a snapshot.
# The installer defaults to admin / 123456; a hash of the public default
# requires a password change before any administrator business operation.
CONTROL_BOOTSTRAP_ADMIN_PASSWORD_HASH="REPLACE_WITH_VERSIONED_PASSWORD_HASH"

# File contains a Base64-encoded random key of at least 32 decoded bytes.
# It must be different from every administrator/customer password and should be
# root:hlpanel 0640. Rotation invalidates only outstanding password-change
# idempotency fingerprints; it does not change stored login password hashes.
CONTROL_CUSTOMER_PASSWORD_FINGERPRINT_KEY_FILE=/etc/hl-panel/customer-password-fingerprint-key

# Optional one-time defaults for automatic VLESS + Reality + Vision creation.
# Set both only after verifying that the chosen DNS name and destination are
# suitable for Reality from the actual entry nodes. Never copy an unverified
# target from another panel. The private key and Short ID are generated per rule.
# CONTROL_REALITY_SERVER_NAME=verified.example.com
# CONTROL_REALITY_DESTINATION=verified.example.com:443
CONTROL_PROTOCOL_PROBE_XRAY_BINARY=/opt/hl-panel/xray
CONTROL_PROTOCOL_PROBE_ECHO_PORT=19090
CONTROL_PROTOCOL_PROBE_INTERVAL=15s

# Loopback HTTP is intentional behind the local HTTPS reverse proxy. The API
# must not receive a public bind address and does not need direct TLS here.
# CONTROL_TLS_CERT_FILE=
# CONTROL_TLS_KEY_FILE=

# Optional Nezha V2 read-only monitoring. Use only a loopback IP literal and
# a separate local Dashboard; never place the PAT in this environment file.
# PAT needs nezha:inventory:read and a server-ID whitelist. The map contains
# explicit HL node ID -> Nezha server ID pairs, e.g. {"nod_...": 12}.
# Keep both files root:hlpanel 0640; no hostname-based matching is performed.
# CONTROL_NEZHA_DASHBOARD_URL=http://127.0.0.1:8008
# CONTROL_NEZHA_PAT_FILE=/etc/hl-panel/nezha-pat
# CONTROL_NEZHA_NODE_MAP_FILE=/etc/hl-panel/nezha-node-map.json
# CONTROL_NEZHA_TIMEOUT=3s
